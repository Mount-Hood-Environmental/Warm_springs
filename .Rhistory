ggplot(summary_uniquedt, aes(x = as.factor(month), y = n)) %>%
geom_point()
ggplot(summary_uniquedt, aes(x = as.factor(month), y = n)) + geom_point()
ggplot(summary_uniquedt, aes(x = as.factor(month), y = n)) + geom_point() + facet_wrap(~location_name_revised)
ggplot(summary_uniquedt, aes(x = as.factor(month), y = n)) + geom_point() + facet_grid(rows = vars(location_name_revised), cols = vars(year))
summary_uniquedt %>% filter(n > 3) %>% ggplot( aes(x = as.factor(month), y = n)) + geom_point() + facet_grid(rows = vars(location_name_revised), cols = vars(year))
summary_uniquedt %>% filter(n > 3)
print(summary_uniquedt %>% filter(n > 3), print = 37)
print(summary_uniquedt %>% filter(n > 3), n =37)
print(summary_uniquedt %>% filter(n >= 3), n =37)
print(summary_uniquedt %>% filter(n >= 3), n =63)
unique_dt <- discharge %>%
mutate(month_loc_year = paste(month, location_name_revised, year, sep = "_"))%>%
mutate(datetime = as.POSIXct(paste(activity_date, time, sep = " "),
format = "%Y-%m-%d %H:%M")) %>%
dplyr::select(location_name_revised, datetime, flow_cfs, month_loc_year, month, year, water_year_season) %>%
distinct()%>% filter(n >= 3)
unique_dt <- discharge %>%
mutate(month_loc_year = paste(month, location_name_revised, year, sep = "_"))%>%
mutate(datetime = as.POSIXct(paste(activity_date, time, sep = " "),
format = "%Y-%m-%d %H:%M")) %>%
dplyr::select(location_name_revised, datetime, flow_cfs, month_loc_year, month, year, water_year_season) %>%
distinct()%>%
ungroup() %>%
group_by(location_name_revised, year, month) %>%
mutate(n = n()) %>%
filter(n >= 3)
unique_dt
View(unique_dt)
